{
  "imports": {
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.2.2/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "@assets": "./assetPaths.ts",
    "@std/fs/walk": "https://deno.land/std@0.224.0/fs/walk.ts"
  },
  "unstable": ["temporal"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "lume",
    "types": ["lume/types.ts"]
  },
  "tasks": {
    "lume": "deno task generate-assets && deno run -A lume/cli.ts",
    "generate-assets": "deno run -A tools/generate-assets.ts",
    "build": "deno task lume",
    "serve": "deno task lume -s"
  }
}
